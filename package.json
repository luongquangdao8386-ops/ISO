{
  "name": "iso",
  "private": true,
  "version": "1.0.0-d3.1",
  "description": "ISO · 体系管理 — kiểm soát tài liệu, biểu mẫu, hồ sơ ISO 9001/14001/45001/50001 + BRCGS Packaging. Google Apps Script + PWA (GitHub Pages)",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node tools/build.mjs && node --test \"tests/server/*.test.mjs\"",
    "test:ui": "node tools/build.mjs && node --test --test-concurrency=1 \"tests/ui/*.test.mjs\"",
    "check": "node tools/build.mjs && node --test \"tests/server/*.test.mjs\" && node tools/scan-secrets.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
